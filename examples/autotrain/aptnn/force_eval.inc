
 &FORCE_EVAL
   METHOD  QS
   &DFT
     ! NOTE: This is the first run file being executed
     WFN_RESTART_FILE_NAME field_mx-RESTART.wfn  

     BASIS_SET_FILE_NAME GTH_BASIS_SETS
     POTENTIAL_FILE_NAME GTH_RPBE_POTENTIALS
     &SCF
       MAX_SCF  100
       EPS_SCF     9.9999999999999995E-08
       SCF_GUESS  RESTART
       &OT  T
         MINIMIZER  DIIS
         SAFE_DIIS  T
         PRECONDITIONER FULL_ALL
       &END OT
       &OUTER_SCF  T
         EPS_SCF     9.9999999999999995E-08
         MAX_SCF  10
       &END OUTER_SCF
       &PRINT
         &RESTART ON 
         &END RESTART
         &RESTART_HISTORY OFF
         &END RESTART_HISTORY
       &END PRINT
     &END SCF
     &QS
       EPS_DEFAULT     9.9999999999999998E-13
       METHOD  GPW
     &END QS
     &MGRID
       NGRIDS  4
       CUTOFF     6.0000000000000000E+02
       REL_CUTOFF 2.0000000000000000E+01
     &END MGRID
     &XC
       DENSITY_CUTOFF     1.0000000000000000E-10
       GRADIENT_CUTOFF     1.0000000000000000E-10
       TAU_CUTOFF     1.0000000000000000E-10
       &XC_GRID
         XC_SMOOTH_RHO  NN50
         XC_DERIV  NN50_SMOOTH
       &END XC_GRID
       &XC_FUNCTIONAL  NO_SHORTCUT
         &LIBXC  T
           FUNCTIONAL XC_GGA_C_PBE
         &END LIBXC
         &LIBXC  T
           FUNCTIONAL XC_GGA_X_RPBE 
         &END LIBXC
       &END XC_FUNCTIONAL
       &VDW_POTENTIAL
         POTENTIAL_TYPE  PAIR_POTENTIAL
         &PAIR_POTENTIAL
           R_CUTOFF     1.7000000000000000E+01
           TYPE  DFTD3
           PARAMETER_FILE_NAME dftd3.dat
           EPS_CN     9.9999999999999995E-07
           D3_SCALING     1.0000000000000000E+00    8.7200000000000000E-01    5.1400000000000001E-01
           CALCULATE_C9_TERM  F
           LONG_RANGE_CORRECTION  T
           VERBOSE_OUTPUT  T
         &END PAIR_POTENTIAL
       &END VDW_POTENTIAL
     &END XC
     &POISSON
       POISSON_SOLVER  PERIODIC
       PERIODIC  XYZ
     &END POISSON
     &LOCALIZE T
       MAX_ITER 5000
       USE_HISTORY T
       OUT_ITER_EACH 100
       EPS_LOCALIZATION 1.00E-03
       METHOD JACOBI
       &PRINT
         &WANNIER_CENTERS SILENT
           ADD_LAST NUMERIC
           COMMON_ITERATION_LEVELS 1
           IONS+CENTERS T
           FORMAT XMOL
           &EACH
             MD 1
           &END EACH
         &END WANNIER_CENTERS
         &TOTAL_DIPOLE OFF
         &END TOTAL_DIPOLE
         &MOLECULAR_DIPOLES OFF
         &END MOLECULAR_DIPOLES
       &END PRINT
     &END LOCALIZE

     &PERIODIC_EFIELD
       INTENSITY ${FIELD_INTENSITY}
       POLARISATION ${FIELD_POLARISATION}
     &END PERIODIC_EFIELD

   &END DFT
   &SUBSYS
     &CELL
       ABC   15.6627 15.6627 15.6627
       PERIODIC  XYZ
       MULTIPLE_UNIT_CELL  1 1 1
     &END CELL
     &KIND O
       BASIS_SET TZV2P-GTH
       POTENTIAL GTH-RPBE-q6
       &POTENTIAL
2 4
0.2419461297000000E+00 2 -0.1691830752000000E+02  0.2521388011000000E+01
2
0.2205415481000000E+00 1  0.1842622765000000E+02
0.2153156734000000E+00 0
       &END POTENTIAL
     &END KIND
     &KIND H
       BASIS_SET TZV2P-GTH
       POTENTIAL GTH-RPBE-q1
       &POTENTIAL
1
0.2000000000000000E+00 2 -0.4177422571000000E+01  0.7233582498000000E+00
0
       &END POTENTIAL
     &END KIND
     &TOPOLOGY
       COORD_FILE_NAME start.xyz
       COORD_FILE_FORMAT xyz
     &END TOPOLOGY
   &END SUBSYS
 &END FORCE_EVAL
