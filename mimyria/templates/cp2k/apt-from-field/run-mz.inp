
&GLOBAL 
  PRINT_LEVEL LOW
  PROJECT_NAME field_mz
  RUN_TYPE MD
&END GLOBAL
&MOTION 
  &MD
    ENSEMBLE REFTRAJ
    &REFTRAJ
      EVAL ENERGY_FORCES
      FIRST_SNAPSHOT 30
      LAST_SNAPSHOT 30
      TRAJ_FILE_NAME configurations.xyz
    &END REFTRAJ
  &END MD  
  &PRINT
    &TRAJECTORY OFF
    &END TRAJECTORY
    &FORCES ON
    &END FORCES
  &END PRINT
&END MOTION

@SET WFN_RESTART field_mx-RESTART.wfn

@SET FIELD_INTENSITY 5e-4 
@SET FIELD_POLARISATION 0.0 0.0 -1.0
@include 'force_eval.inc'
                
